# Modele du .env de PRODUCTION (cf. DEPLOY-VPS.txt section 4).
# Copier en .env sur le VPS, remplir, ne JAMAIS committer le resultat.

# --- Compose -----------------------------------------------------------------
COMPOSE_FILE=compose.prod.yml
COMPOSE_PROJECT_NAME=parrain
BACKEND_PORT=8000
GUNICORN_WORKERS=3

# --- Django ------------------------------------------------------------------
# Genere par : python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=False

# --- Base de donnees ----------------------------------------------------------
# DB_HOST/DB_PORT sont imposes par compose.prod.yml (service "db"), inutile de les
# renseigner ici.
DB_NAME=le_parrain
DB_USER=le_parrain
DB_PASSWORD=

# --- Domaines (listes separees par des virgules) --------------------------------
# S'ajoutent aux valeurs de developpement codees dans le_parrain/settings.py.
EXTRA_ALLOWED_HOSTS=api.mondomaine.com
EXTRA_CORS_ORIGINS=https://console.mondomaine.com
EXTRA_CSRF_ORIGINS=https://api.mondomaine.com,https://console.mondomaine.com

# --- Signature des codes d'activation (console systeme) ------------------------
# Genere par : docker compose exec backend python manage.py generer_cle_editeur
# La cle privee est un secret ; la publique non.
EDITEUR_ED25519_PRIVATE_KEY_B64=
EDITEUR_ED25519_PUBLIC_KEY_B64=

# --- Coordonnees affichees sur l'ecran "Abonnement" -----------------------------
EDITEUR_MOBILE_MONEY_NUMERO=
EDITEUR_ORANGE_MONEY_NUMERO=

# --- Amorcage du premier compte editeur (commande amorcer_console) --------------
# Peuvent etre retires du .env une fois le compte cree.
EDITEUR_BOOTSTRAP_EMAIL=editeur@mondomaine.com
EDITEUR_BOOTSTRAP_PASSWORD=
